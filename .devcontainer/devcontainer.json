{
  "name": "ai-data-summarizer",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "uv sync --frozen",
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
